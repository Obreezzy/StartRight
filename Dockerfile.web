# The StartRight chat site. No embedding model is installed: the hosted site uses
# RETRIEVAL_MODE=bm25_light (keyword search), so it fits a 512 MB free server.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY requirements-web.txt .
RUN pip install --no-cache-dir -r requirements-web.txt

COPY src ./src

RUN useradd --create-home appuser
USER appuser

# Render sets PORT (10000 by default); 8002 is the local default.
EXPOSE 10000
CMD ["sh", "-c", "uvicorn startright.webapp:app --host 0.0.0.0 --port ${PORT:-8002}"]
